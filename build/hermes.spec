# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec, HERMES onedir bundle.

Produces dist/HERMES/HERMES.exe + _internal/. assets/ (icons) land INSIDE _internal/, that
is dist.1's _MEIPASS anchor, so the icon loader resolves them in the frozen app. ffmpeg.exe
is NOT bundled as of 9.3b - it downloads on demand into the writable bin/ dir the first
time a module that needs it is enabled; find_ffmpeg() checks PATH, then that download
target, then assets/ffmpeg.exe (a dev/run-from-source fallback only).

Paths are anchored to SPECPATH (this file's dir = build/), so the build is independent of
the cwd PyInstaller was launched from. Driven by build/build.py (it generates
version_info.txt first and sets HERMES_CONSOLE for the first-boot debug build)."""
import os

from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs, collect_submodules

REPO = os.path.dirname(SPECPATH)          # build/ -> repo root
ASSETS = os.path.join(REPO, "assets")

# Bundled data -> _internal/assets/. EVERY file in assets/ ships except *.exe (ffmpeg
# is on-demand, 9.3b, never bundled) - walks the folder, not a hand-picked list, so a new
# icon dropped into assets/ ships automatically instead of silently missing until
# someone notices in a real build. A hand-picked list already caused this twice in
# one day (2026-07-17): first hermes.ico/hermes.png (read at runtime by main.py's
# _set_window_icon() and shared/ui_helpers.load_brand_icon() - separate from icon_arg
# below, which only embeds hermes.ico into the EXE's own Win32 resource for the
# taskbar/Explorer/shortcuts), then discord.png/kofi.png/x.png (the social link bar).
# Walked recursively with each file's own subfolder as its destination: a plain
# (dir, "assets") entry copies a subfolder's CONTENTS flat into assets/, which is how
# the subtitle fonts once landed beside the icons instead of in assets/fonts/.
datas = []
for _dirpath, _dirnames, _filenames in os.walk(ASSETS):
    _rel = os.path.relpath(_dirpath, ASSETS)
    _dest = "assets" if _rel == "." else os.path.join("assets", _rel)
    datas += [(os.path.join(_dirpath, n), _dest) for n in _filenames
              if not n.lower().endswith(".exe")]
# tkinterdnd2 ships the tkdnd Tcl library as data files; without them drag-and-drop import
# silently dies in the frozen app (it degrades gracefully, but we want it working).
datas += collect_data_files("tkinterdnd2")

# The hub lazy-imports tabs via importlib.import_module("modules.home") with STRING names
# from the registry, so PyInstaller's static analysis can't see them; collect the whole
# modules/ package or the frozen app boots tabless ("No module named 'modules'").
hiddenimports = collect_submodules("modules")
# yt_dlp is pure-python but its extractors are imported dynamically; collect them so the URL
# import isn't tree-shaken to death. cv2/numpy/PIL are covered by PyInstaller's stock hooks.
# The filter skips yt_dlp.__pyinstaller (its build-time hook): collecting it pulled the
# whole PyInstaller package (GPL, build tooling) into the shipped app.
hiddenimports += collect_submodules("yt_dlp", filter=lambda name: "__pyinstaller" not in name)
# faster-whisper (bundled, 6.1) + its ctranslate2 dependency: ctranslate2 is a compiled
# extension with its own bundled DLLs (the CPU inference engine, ~60MB) that static analysis
# misses, so its hiddenimports and dynamic libs are collected explicitly.
# PyAV is left out on purpose (excludes below): faster-whisper only uses it to decode audio
# files, and HERMES passes it decoded samples instead (shared/whisper_engine.py). Its FFmpeg
# copy is ~69 MB and carries GPL encoders (x264, x265) that were never used. faster_whisper also
# ships a real binary asset alongside its .py files - assets/silero_vad_v6.onnx, its
# voice-activity-detection model - collect_submodules only grabs .py hidden imports, so this
# was confirmed missing from a real build (measured, not assumed) before adding it here.
hiddenimports += collect_submodules("faster_whisper")
hiddenimports += collect_submodules("ctranslate2")
datas += collect_data_files("faster_whisper")
binaries = collect_dynamic_libs("ctranslate2")

# First-boot debug build surfaces tracebacks in a console; release is windowed.
console = os.environ.get("HERMES_CONSOLE") == "1"

icon_path = os.path.join(ASSETS, "hermes.ico")
icon_arg = icon_path if os.path.exists(icon_path) else None       # tolerate a missing icon

ver_path = os.path.join(SPECPATH, "version_info.txt")
ver_arg = ver_path if os.path.exists(ver_path) else None          # generated by build.py


a = Analysis(
    [os.path.join(REPO, "main.py")],
    pathex=[REPO],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["av"],
    noarchive=False,
)
# Safety net next to build.py's environment check: onnxruntime's GPU execution
# providers are never loaded (faster-whisper runs its voice filter on the CPU
# provider) and one of them alone is over GitHub's 100 MB file limit.
_NEVER_BUNDLE = ("onnxruntime_providers_cuda.dll", "onnxruntime_providers_tensorrt.dll")
a.binaries = [b for b in a.binaries
              if os.path.basename(b[0]).lower() not in _NEVER_BUNDLE]
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="HERMES",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,                # UPX risks AV false positives for marginal size gain (spec)
    console=console,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=icon_arg,
    version=ver_arg,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="HERMES",            # onedir: dist/HERMES/ with _internal/ (PyInstaller 6 default)
)
